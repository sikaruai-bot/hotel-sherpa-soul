generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   @default("frontdesk123")
  pinCode   String?  @default("1234")
  name      String
  role      Role     @default(RECEPTIONIST)
  shift     String?  @default("Morning")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  ACCOUNTANT
}

model RoomType {
  id          String   @id @default(uuid())
  name        String   @unique
  capacity    Int
  bedType     String
  dailyRate   Float
  weeklyRate  Float
  monthlyRate Float
  rooms       Room[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id                 String             @id @default(uuid())
  roomNumber         String             @unique
  floor              Int
  roomTypeId         String
  roomType           RoomType           @relation(fields: [roomTypeId], references: [id])
  status             RoomStatus         @default(AVAILABLE)
  kitchenEligible    Boolean            @default(false)
  longStayEligible   Boolean            @default(false)
  currentGuest       String?
  cleaningStaff      String?
  maintenanceNote    String?
  reservations       Reservation[]
  longStayContracts  LongStayContract[]
  kitchenUsers       KitchenUser[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CHECK_IN_TODAY
  CHECK_OUT_TODAY
  CLEANING_REQUIRED
  UNDER_MAINTENANCE
  LONG_STAY_OCCUPIED
}

model Guest {
  id                String             @id @default(uuid())
  name              String
  nationality       String?
  passportNumber    String?
  email             String?
  phoneNumber       String?
  reservations      Reservation[]
  longStayContracts LongStayContract[]
  kitchenUsers      KitchenUser[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Reservation {
  id              String            @id @default(uuid())
  otaConfirmNum   String?
  guestId         String
  guest           Guest             @relation(fields: [guestId], references: [id])
  roomId          String
  room            Room              @relation(fields: [roomId], references: [id])
  checkInDate     DateTime
  checkOutDate    DateTime
  adults          Int               @default(1)
  children        Int               @default(0)
  totalAmount     Float
  paidAmount      Float             @default(0)
  status          ReservationStatus @default(PENDING)
  source          BookingSource     @default(DIRECT)
  specialRequests String?
  invoices        Invoice[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum ReservationStatus {
  CONFIRMED
  PENDING
  CANCELLED
  NO_SHOW
  CHECKED_IN
  CHECKED_OUT
}

enum BookingSource {
  BOOKING_COM
  AGODA
  AIRBNB
  TRIP_COM
  EXPEDIA
  VRBO
  DIRECT
  WEBSITE
  WHATSAPP
  WALK_IN
  PHONE
  MANUAL
}

model LongStayContract {
  id              String         @id @default(uuid())
  guestId         String
  guest           Guest          @relation(fields: [guestId], references: [id])
  roomId          String
  room            Room           @relation(fields: [roomId], references: [id])
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Float
  securityDeposit Float
  kitchenAccess   Boolean        @default(true)
  depositStatus   String         @default("HELD") // HELD, REFUNDED, DEDUCTED
  rentPaidUntil   DateTime?
  status          ContractStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum ContractStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
  TERMINATED
}

model KitchenUser {
  id              String   @id @default(uuid())
  guestId         String
  guest           Guest    @relation(fields: [guestId], references: [id])
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  passType        String   @default("Long Stay") // Long Stay, Short Stay Add-on
  accessStartDate DateTime
  accessEndDate   DateTime
  depositHeld     Float    @default(0)
  depositStatus   String   @default("HELD") // HELD, REFUNDED, PARTIAL_DEDUCTED
  status          String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KitchenInventory {
  id        String          @id @default(uuid())
  itemName  String
  status    InventoryStatus @default(AVAILABLE)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum InventoryStatus {
  AVAILABLE
  IN_USE
  DAMAGED
  MISSING
  REPLACEMENT_NEEDED
}

model KitchenIncident {
  id         String   @id @default(uuid())
  incidentDate DateTime @default(now())
  type       String
  guestName  String
  roomNumber String
  costNpr    Float
  status     String   @default("Pending Review") // Deducted from Deposit, Waived, Pending Review
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  reservationId String?
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime      @default(now())
  guestName     String?
  roomNumber    String?
  items         String?       // Stored JSON string of line items
  subtotal      Float
  tax           Float         // 13% VAT
  serviceCharge Float         @default(0) // 10% Service Charge
  discount      Float         @default(0)
  total         Float
  paidAmount    Float         @default(0)
  paymentMethod String?
  status        InvoiceStatus @default(UNPAID)
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  amount        Float
  method        PaymentMethod
  paymentDate   DateTime      @default(now())
  transactionId String?
}

enum PaymentMethod {
  CASH_NPR
  CASH_USD
  VISA
  MASTERCARD
  UNIONPAY
  ESEWA
  KHALTI
  BANK_TRANSFER
}

model HousekeepingTask {
  id           String     @id @default(uuid())
  roomId       String
  room         Room       @relation(fields: [roomId], references: [id])
  taskType     String     // Regular Clean, Deep Clean, Turnover Clean, Linen Change
  status       TaskStatus @default(PENDING)
  priority     String     @default("NORMAL") // NORMAL, HIGH, URGENT
  assignedTo   String?    // Staff Name
  notes        String?
  scheduledFor DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  INSPECTED
}

model MaintenanceTicket {
  id                 String   @id @default(uuid())
  roomId             String?
  room               Room?    @relation(fields: [roomId], references: [id])
  location           String
  issue              String
  priority           String   @default("Medium") // Low, Medium, Urgent
  status             String   @default("Open")   // Open, In Progress, Resolved
  reportedBy         String
  assignedTechnician String?
  reportedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  detail    String
  type      String   @default("General") // Booking, LongStay, Billing, Kitchen, Maintenance, Channel
  channel   String   @default("In-App")  // WhatsApp, Email, In-App, SMS
  status    String   @default("Delivered") // Delivered, Action Required, Resolved
  createdAt DateTime @default(now())
}

model WebhookEndpoint {
  id          String       @id @default(uuid())
  name        String       // e.g. "Zapier Booking Sync", "WhatsApp Bot"
  url         String
  secret      String?
  events      String       // Stored JSON array e.g. '["booking.created", "guest.checked_in"]'
  isActive    Boolean      @default(true)
  logs        WebhookLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model WebhookLog {
  id          String          @id @default(uuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  status      Int             // HTTP status code (e.g. 200, 500)
  response    String?
  payload     String          // Stored JSON payload
  createdAt   DateTime        @default(now())
}

model OtaConnection {
  id           String    @id @default(uuid())
  channel      String    // BOOKING_COM, AIRBNB, AGODA, EXPEDIA, TRIP_COM, VRBO, CUSTOM
  roomNumber   String    // 201, 202, 203, 301, 302, 303, ALL
  importUrl    String?   // External OTA iCal URL pasted by user
  exportToken  String    @default(uuid()) // PMS calendar export token
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  syncStatus   String    @default("IDLE") // IDLE, SYNCING, SUCCESS, ERROR
  syncMessage  String?
  eventsCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([channel, roomNumber])
}

model OtaSyncLog {
  id          String   @id @default(uuid())
  channel     String
  roomNumber  String
  action      String   // IMPORT_ICAL, EXPORT_ICAL, WEBHOOK_PUSH, RATE_PUSH, MANUAL_SYNC
  status      String   // SUCCESS, CONFLICT_PREVENTED, ERROR
  message     String
  details     String?  // JSON string
  createdAt   DateTime @default(now())
}

model HotelSetting {
  id                   String   @id @default("default")
  hotelName            String   @default("Hotel Sherpa Soul")
  officialEmail        String   @default("info@hotelsherpasoul.com")
  managerEmail         String   @default("manager@hotelsherpasoul.com")
  phone                String   @default("+977 9801234567")
  address              String   @default("Bhagawati Marg -26, Thamel, Kathmandu, Nepal")
  notifyOnBooking      Boolean  @default(true)
  notifyGuestOnBooking Boolean  @default(true)
  notifyOnRoomFull     Boolean  @default(true)
  smtpHost             String?
  smtpPort             Int?     @default(587)
  smtpUser             String?
  smtpPass             String?
  smtpSecure           Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

